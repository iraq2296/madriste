# ==============================================================================
# MADRASI — مَدرَستي
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Backend & PostgreSQL Database)
# ------------------------------------------------------------------------------
# Public Supabase URL (safe to bundle in mobile app, protected by RLS)
SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (safe to bundle in mobile app, protected by RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Service Role Key (NEVER put in mobile client! For Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Iraqi Payments Gateway (Mastercard Only)
# ------------------------------------------------------------------------------
# Provider identifier (e.g., MPGS_IRAQ, QI_MASTERCARD, ASIAHAWALA_MASTERCARD)
PAYMENT_PROVIDER=MPGS_IRAQ
PAYMENT_MERCHANT_ID=merchant.iq.madrasi
PAYMENT_API_SECRET=sec_live_xxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Audio & Video Calls (Agora RTC - Free & Unlimited Duration)
# ------------------------------------------------------------------------------
# Agora App ID (public client key)
AGORA_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Agora App Certificate (backend secret only, for minting RTC tokens)
AGORA_APP_CERTIFICATE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. Identity Verification & Face Matching (Liveness)
# ------------------------------------------------------------------------------
# Provider (e.g., AWS_REKOGNITION, AZURE_FACE, FACETEC)
FACE_PROVIDER=AWS_REKOGNITION
FACE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
FACE_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. Push Notifications (FCM / APNs)
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=AAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
